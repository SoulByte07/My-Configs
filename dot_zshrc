# ==================================== Alias =======================================

# yazi
alias fs='yazi'

#mount GoogleDrive
# This starts the systemd service manually
alias mgd='systemctl --user start rclone-mount-googledrive && echo "✅ Google Drive Mounted"'

# Optional: If you want to unmount manually before shutdown
alias ugd='systemctl --user stop rclone-mount-googledrive && echo "🛑 Google Drive Unmounted"'

# mount EncryptedGoogleDrive
# This starts the systemd service manually
alias megd='systemctl --user start rclone-mount-encryptgoogledrive && echo "✅ Encrypt Google Drive Mounted"'

# Optional: If you want to unmount manually before shutdown
alias uegd='systemctl --user stop rclone-mount-encryptgoogledrive && echo "🛑 Encrypt Google Drive Unmounted"'


