# Docker cleanup (useful for active development)
docker-cleanup() {
  echo "🐳 Cleaning up Docker..."
  docker system prune -a --volumes -f
  echo "✅ Docker cleaned up"
}

# Kubernetes pod logs with fzf
kl-fzf() {
  if ! command -v kubectl &> /dev/null; then
    echo "kubectl not installed"
    return 1
  fi
  local pod=$(kubectl get pods --all-namespaces -o name | \
    fzf --preview 'kubectl logs {} --tail=50' --preview-window=right:50%)
  if [[ -n "$pod" ]]; then
    kubectl logs -f "$pod"
  fi
}

# Search git history with fzf
git-search() {
  git log --oneline --all --graph | fzf --preview 'git show {1}' | awk '{print $1}'
}

# Quick git clone to projects directory
gcl() {
  if [[ -z "$1" ]]; then
    echo "Usage: gcl <repo-url>"
    return 1
  fi
  local repo_name=$(basename "$1" .git)
  git clone "$1" ~/projects/"$repo_name" 2>/dev/null && \
  cd ~/projects/"$repo_name" && \
  echo "✅ Cloned to: $(pwd)" || \
  echo "❌ Clone failed"
}

# ============================================
# POWERLEVEL10K CONFIGURATION
# ============================================
# To customize prompt, run: p10k configure
# Configuration is saved to ~/.p10k.zsh
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

