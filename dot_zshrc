# ~/.zshrc - Production Cloud Engineer Setup
# Fedora + Kitty + Zsh + Powerlevel10k (P10k) + Direct Source
# Optimized for speed, simplicity, and DevOps workflows

# ============================================
# INSTANT PROMPT (Powerlevel10k - MUST BE AT TOP)
# ============================================
# Enable instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ============================================
# ZSH TOOLS & PROMPT INITIALIZATION
# ============================================

# Powerlevel10k: Instant prompt with async git status (50x faster than P9k)
# To re-run configuration wizard: p10k configure
source ~/powerlevel10k/powerlevel10k.zsh-theme

# fzf: Fuzzy finder (keybindings: Ctrl+R, Ctrl+T, Alt+C)
source <(fzf --zsh)

# thefuck: Correct previous command
eval $(thefuck --alias)
# zoxide: Smarter directory jumper (replaces cd)
eval "$(zoxide init zsh --cmd cd)"

# ============================================
# KITTY SHELL INTEGRATION (Fedora system path)
# ============================================
# Enables: Cmd+Up/Down to jump between prompts
if test -e "/usr/lib64/kitty/shell-integration/zsh/kitty.zsh"; then
    source "/usr/lib64/kitty/shell-integration/zsh/kitty.zsh"
fi

# ============================================
# PATH & ENVIRONMENT VARIABLES
# ============================================

export PATH="$HOME/.local/bin:$PATH"
export SHELL=/usr/bin/zsh
export EDITOR=nvim
export VISUAL=nvim
export LANG=en_US.UTF-8

# open arch wiki in vim
export MANPAGER="nvim +Man!"
export PAGER="nvim"

# gemini sandbox
#export GEMINI_SANDBOX=true
##export SANDBOX_MOUNTS="$PWD:$PWD:rw
#export GEMINI_SANDBOX_PROVIDER=podman

# cargo is used to install RUST apps
export PATH="$HOME/.cargo/bin:$PATH"


# ============================================
# ALIASES: POWER USER SETUP
# ============================================

# --- File Managers & Editors ---
alias fs='yazi'                    # Modern file manager (Rust-based)
alias vm='nvim'                    # Professional editor

# --- Safe Deletion (Recoverable) ---
alias rm='rmtrash'                 # rm that moves to trash (recoverable!)
alias rmdir='rmdirtrash'           # Safe rmdir

# --- List Alternative: eza (better than ls) ---
alias ls="eza --color=always --long --git --icons=always --no-filesize --no-time --no-user --no-permissions"
alias ll="eza --color=always --long --git --icons=always"
alias la="eza --color=always --all --icons=always"

# --- Utilities ---
alias fk='fuck'                    # Correct previous command
alias cz='chezmoi'                 # Dotfiles management
#alias grep='grep --color=auto'
alias diff='diff --color=auto'

# --- Clipboard ---
alias cf='xclip -selection clipboard <'     # Copy file to clipboard
alias cp-stdin='xclip -selection clipboard' # Copy stdin to clipboard

# --- Google Drive Mounts ---
alias mgd='systemctl --user start rclone-mount-googledrive && echo "✅ Google Drive Mounted"'
alias ugd='systemctl --user stop rclone-mount-googledrive && echo "🛑 Google Drive Unmounted"'
alias megd='systemctl --user start rclone-mount-encryptgoogledrive && echo "✅ Encrypted Google Drive Mounted"'
alias uegd='systemctl --user stop rclone-mount-encryptgoogledrive && echo "🛑 Encrypted Google Drive Unmounted"'

# --- VS Codium (Flatpak) ---
alias code='flatpak run com.vscodium.codium'

# --- FZF Integrations ---
alias inv='nvim $(fzf -m --preview="bat --color=always {}")'
alias fcd='cd $(find . -type d 2>/dev/null | fzf)'

# --- Distrobox Gemini ---
#alias gem='distrobox enter gemini-lab --additional-flags "--env GEMINI_API_KEY=$(secret-tool lookup service gemini user me)" -- gemini'

# --- Navigation shortcuts ---
alias ...='cd ../..'
alias ....='cd ../../..'


# flatpak setup
alias fks='flatpak search'
alias fki='flatpak install'

# ============================================
# ZSH HISTORY
# ============================================

HISTSIZE=50000
SAVEHIST=50000
HISTFILE=~/.zsh_history

# History options
#setopt APPEND_HISTORY              # Append to history, don't overwrite
#setopt SHARE_HISTORY               # Share history across sessions
#setopt HIST_IGNORE_DUPS            # Ignore duplicate commands
#setopt HIST_FIND_NO_DUPS           # Don't show duplicates in search
#setopt HIST_IGNORE_SPACE           # Ignore lines starting with space
#setopt HIST_IGNORE_ALL_DUPS        # Remove older duplicates
#setopt HIST_SAVE_NO_DUPS           # Don't save duplicate commands
#setopt INC_APPEND_HISTORY          # Add to history immediately


setopt SHARE_HISTORY             # Share history between all sessions (includes INC_APPEND_HISTORY)
setopt HIST_EXPIRE_DUPS_FIRST    # Expire duplicate entries first when trimming history.
setopt HIST_IGNORE_DUPS          # Don't record an entry that was just recorded.
setopt HIST_IGNORE_ALL_DUPS      # Delete old recorded entry if new entry is a duplicate.
setopt HIST_FIND_NO_DUPS         # Do not display a line previously found.
setopt HIST_IGNORE_SPACE         # Don't record an entry starting with a space.
setopt HIST_SAVE_NO_DUPS         # Don't write duplicate entries to history file.
setopt HIST_REDUCE_BLANKS        # Remove superfluous blanks before recording entry.
setopt EXTENDED_HISTORY          # Write the history file in the ":start:elapsed;command" format.


# ============================================
# ZSH PLUGINS & AUTOCOMPLETION (System Packages)
# ============================================

# Load from Fedora system packages (faster than external managers)
# These are provided by: zsh-autosuggestions, zsh-syntax-highlighting packages

if [[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  # Configure autosuggestions
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'  # Gray color for suggestions
  ZSH_AUTOSUGGEST_STRATEGY=(match_prev_cmd completion history)
fi

if [[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
  # Configuration for syntax highlighting
  ZSH_HIGHLIGHT_STYLES[comment]='fg=8'
fi

# zsh-autocomplete (newer than zsh-completions)
if [[ -f ~/.zsh-autocomplete/zsh-autocomplete.plugin.zsh ]]; then
  source ~/.zsh-autocomplete/zsh-autocomplete.plugin.zsh
fi

# ============================================
# KEY BINDINGS
# ============================================

# Delete word backward (your keybinding)
bindkey '^H' backward-kill-word

# Emacs-style navigation
bindkey '^A' beginning-of-line
bindkey '^E' end-of-line
bindkey '^U' backward-kill-line
bindkey '^K' kill-line

# History search with arrow keys (prefix-based)
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward

# ============================================
# COMPLETION OPTIMIZATION (Daily Cache)
# ============================================
# Builds completion cache once daily, not on every startup
# This is the key to fast completion initialization

autoload -Uz compinit

if [[ -n $HOME/.cache/zsh/zcompdump-$ZSH_VERSION(#qN.mh+24) ]]; then
    compinit -d "$HOME/.cache/zsh/zcompdump-$ZSH_VERSION"
else
    compinit -C -d "$HOME/.cache/zsh/zcompdump-$ZSH_VERSION"
fi

# Completion styling
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'       # Case-insensitive
zstyle ':completion:*:cd:*' list-dirs-first true               # Directories first
zstyle ':completion:*' list-colors '${(s.:.)LS_COLORS}'        # Colored completions

# ============================================
# CUSTOM FUNCTIONS (DevOps-Focused)
# ============================================

# Kill process interactively with fzf
fkill() {
  if [[ -z "$1" ]]; then
    local pid=$(ps aux | fzf | awk '{print $2}')
    [[ -n "$pid" ]] && kill -9 "$pid" && echo "✅ Killed process $pid"
  else
    kill -9 "$1" && echo "✅ Killed process $1"
  fi
}

# Git checkout branch with fzf + preview
gcb() {
  local branch=$(git branch -a | sed 's/^[[:space:]]*//g' | \
    fzf --preview 'git log -1 --oneline {}' --preview-window=right:40%)
  if [[ -n "$branch" ]]; then
    git checkout "${branch#remotes/origin/}"
    echo "✅ Switched to: $branch"
  fi
}

# git add and commit
gac() {
  git add .
  git commit -m "$*"
}


